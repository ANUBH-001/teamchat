{
  "expo": {
    "newArchEnabled": true,
    "name": "TeamChat",
    "slug": "teamchat",
    "version": "0.5.0",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://apps.landauditors.com/team_chat/updates/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.teamchat.app",
      "versionCode": 5,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-asset",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TeamChat uses the microphone for voice typing.",
          "speechRecognitionPermission": "TeamChat uses speech recognition for voice typing."
        }
      ]
    ],
    "extra": {
      "serverUrl": "https://apps.landauditors.com/team_chat"
    }
  }
}
