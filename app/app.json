{
  "expo": {
    "newArchEnabled": true,
    "name": "KlapChat",
    "slug": "teamchat",
    "version": "0.7.0",
    "icon": "./assets/icon.png",
    "runtimeVersion": "2",
    "updates": {
      "url": "https://apps.landauditors.com/team_chat/updates/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.teamchat.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#0A1A30"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-asset",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "KlapChat uses the microphone for voice typing.",
          "speechRecognitionPermission": "KlapChat uses speech recognition for voice typing."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KlapChat camera use karega photo lene ke liye.",
          "microphonePermission": "KlapChat microphone use karega.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KlapChat aapki photos access karega bhejne ke liye.",
          "cameraPermission": "KlapChat camera use karega photo lene ke liye."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "KlapChat photos dekhega.",
          "savePhotosPermission": "KlapChat photos gallery me save karega (KlapChat album).",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KlapChat location use karega geo-tag photo ke liye."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "KlapChat microphone use karega voice note record karne ke liye."
        }
      ]
    ],
    "extra": {
      "serverUrl": "https://apps.landauditors.com/team_chat"
    }
  }
}
