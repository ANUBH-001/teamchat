DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=teamchat
PORT=3000
JWT_SECRET=change-me
# AI task engine: mock (keyword rules, no key) | openai | gemini. Missing key -> mock.
AI_PROVIDER=mock
AI_API_KEY=
# optional; defaults gpt-4.1-mini (openai) / gemini-2.5-flash (gemini)
AI_MODEL=

# nightly backup hour (local time, 0-23)
BACKUP_HOUR=2
